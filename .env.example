# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local nunca é versionado (ver .gitignore).

# Banco de dados (Neon / Vercel Postgres)
DATABASE_URL=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Meta WhatsApp Cloud API (Embedded Signup) — spec 008
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
# Opcional (default v21.0)
META_GRAPH_API_VERSION=v21.0
# AES-256-GCM: 32 bytes em base64 (ex: `openssl rand -base64 32`)
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Gateway de pagamento (Asaas) — spec 010
# API Key da conta Asaas (header access_token nas chamadas REST)
ASAAS_API_KEY=
# Token do webhook (header asaas-access-token) — NÃO use a API Key aqui
ASAAS_WEBHOOK_TOKEN=
# Opcional (default: https://api-sandbox.asaas.com/v3)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3