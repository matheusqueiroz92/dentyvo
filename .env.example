# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local nunca é versionado (ver .gitignore).

# Banco de dados (Neon / Vercel Postgres)
DATABASE_URL=

# Conexão direta (sem pooler) para drizzle-kit e `node scripts/migrate.mjs`.
# Em geral a URL do Neon com host `-pooler` removido.
DATABASE_URL_MIGRATIONS=

# Banco dedicado aos testes e2e (Playwright).
# Use uma branch separada do Neon — NÃO aponte para o mesmo banco de desenvolvimento
# (DATABASE_URL). O webServer do Playwright injeta este valor como DATABASE_URL do app.
DATABASE_URL_E2E=

# URL pública da aplicação (links absolutos: agendamento online, etc.).
# Sem barra final. Hoje o app está em https://dentyvo-three.vercel.app;
# quando o domínio próprio estiver no ar, troque só este valor
# (ex.: https://dentyvo.com.br) — não é preciso caçar hosts no código.
# Exposta ao browser (prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth (BetterAuth socialProviders.google)
# Sem estes valores, o botão "Continuar com Google" falha no provedor.
# NÃO cria clínica automaticamente — só autentica e-mails já vinculados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta WhatsApp Cloud API (Embedded Signup) — spec 008
# App ID do app aprovado no Meta App Review (App Dashboard → Configurações → Básico)
META_APP_ID=
# App Secret do MESMO app — também é a chave do HMAC do webhook (x-hub-signature-256)
META_APP_SECRET=
# Configuration ID do fluxo de Embedded Signup (Tech Provider), não o App ID
META_EMBEDDED_SIGNUP_CONFIG_ID=
# String aleatória sua; o MESMO valor vai no campo "Verify token" do webhook na Meta
META_WEBHOOK_VERIFY_TOKEN=
# Opcional (default v26.0). Usado pelo servidor e pelo SDK JS do Embedded Signup.
# Revisar periodicamente: a Meta aposenta versões em ~2 anos (changelog Graph API).
META_GRAPH_API_VERSION=v26.0
# AES-256-GCM: 32 bytes em base64 (ex: `openssl rand -base64 32`)
# Use uma chave DIFERENTE por ambiente — trocar a chave torna tokens já salvos ilegíveis.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Segredo dos jobs agendados (Vercel Cron envia `Authorization: Bearer $CRON_SECRET`).
# Sem este valor as rotas de cron respondem 401 — inclusive a renovação de token WhatsApp.
CRON_SECRET=

# Gateway de pagamento (Asaas) — spec 010
# API Key da conta Asaas (header access_token nas chamadas REST)
ASAAS_API_KEY=
# Token do webhook (header asaas-access-token) — NÃO use a API Key aqui
ASAAS_WEBHOOK_TOKEN=
# Opcional (default: https://api-sandbox.asaas.com/v3)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Vercel Blob Storage — logo da clínica (e anexos futuros)
# Crie um store em https://vercel.com/docs/storage/vercel-blob
# e copie o token read-write (também injetado automaticamente no deploy Vercel).
BLOB_READ_WRITE_TOKEN=

# Upstash Redis — rate limit do link público de agendamento
# (mesmo provedor do ecossistema QStash; crie um Redis em https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — CAPTCHA na submissão do link público
# https://developers.cloudflare.com/turnstile/
# Obrigatório fora de NODE_ENV=development (staging/preview/production).
# Em development, ausência da secret ativa bypass local — nunca em outros envs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
